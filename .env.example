TORN_API_KEY=put_your_torn_api_key_here
ENEMY_FACTION_ID=12345
FRIENDLY_FACTION_ID=your_friendly_faction_id
POLL_SECONDS=60
HOST=0.0.0.0
PORT=8787

# Optional: ENV_FILE selects another dotenv file at process startup.
URL_PREFIX=
ROOT_URL_HOSTS=
# ACTIVITY_DB_PATH=/absolute/path/to/instance.db

# Administrator only: generate two DIFFERENT PINs using:
# python scripts/hash_chain_pin.py public
# python scripts/hash_chain_pin.py tactician
# Edit these verifiers locally and restart. Rotation invalidates only that role.
PUBLIC_PIN_HASH=
TACTICIAN_PIN_HASH=
# Optional: start a fresh matchup queue without changing the activity database.
# Defaults to ACTIVITY_DB_PATH. Use a new filename when switching enemies.
# CHAIN_DB_PATH=/absolute/path/to/chain-friendlyID-enemyID.db
# Keep true behind HTTPS; set false ONLY for local HTTP testing.
CHAIN_COOKIE_SECURE=true
# Requires a limited key belonging to FRIENDLY_FACTION_ID, with faction API permission.
CHAIN_VERIFY_ATTACKS=true
